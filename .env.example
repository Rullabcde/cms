# Server
SERVER_PORT=8080
APP_ENV=development # development | production | staging

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=cms_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=cms_db
DB_SSLMODE=disable # use "require" in production

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_SECRET

# JWT
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/callback

# Encryption
# Generate with: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=CHANGE_ME_base64_encoded_32byte_key

# CORS
# Comma-separated list of allowed origins. Defaults to FRONTEND_URL if unset.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Bootstrap
ADMIN_EMAIL=admin@company.com
